<.header>
  Listing Scores
</.header>

<form phx-change="filter" class="mb-6 flex flex-wrap gap-4 items-end">
  <div>
    <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">Game</label>
    <select
      name="game_id"
      class="rounded border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
    >
      <option value="">All Games</option>
      <%= for game <- @games do %>
        <option value={game.id} selected={@filters["game_id"] == to_string(game.id)}>
          {game.name}
        </option>
      <% end %>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">Sort</label>
    <select
      name="sort"
      class="rounded border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
    >
      <option value="desc" selected={@filters["sort"] == "desc"}>Highest First</option>
      <option value="asc" selected={@filters["sort"] == "asc"}>Lowest First</option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">
      Number of Scores
    </label>
    <select
      name="limit"
      class="rounded border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
    >
      <option value="">All</option>
      <option value="10" selected={@filters["limit"] == "10"}>10</option>
      <option value="25" selected={@filters["limit"] == "25"}>25</option>
      <option value="50" selected={@filters["limit"] == "50"}>50</option>
    </select>
  </div>

  <%= if @current_user do %>
    <div>
      <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300">User</label>
      <select
        name="user_id"
        class="rounded border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
      >
        <option value="">All Users</option>
        <option
          value={@current_user.id}
          selected={@filters["user_id"] == to_string(@current_user.id)}
        >
          My Scores
        </option>
      </select>
    </div>
  <% end %>
</form>
<.table id="scores" rows={@streams.scores}>
  <:col :let={{_id, score}} label="Score">{score.score}</:col>
  <:col :let={{_id, score}} label="Game">{score.game.name}</:col>
  <:col :let={{_id, score}} label="User">{score.user.user_name}</:col>
</.table>

<.modal
  :if={@live_action in [:new, :edit]}
  id="score-modal"
  show
  on_cancel={JS.patch(~p"/scores")}
>
  <.live_component
    module={GameSiteWeb.ScoreLive.FormComponent}
    id={@score.id || :new}
    title={@page_title}
    action={@live_action}
    score={@score}
    patch={~p"/scores"}
    current_user={@current_user}
  />
</.modal>
