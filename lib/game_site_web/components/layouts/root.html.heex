<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="GameSite" suffix=" · Games">
      {assigns[:page_title]}
    </.live_title>
    <.theme_init_script />
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js">
    </script>
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js">
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-zinc-700 antialiased dark:bg-zinc-950 dark:text-zinc-200">
    <header class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/90 backdrop-blur dark:border-zinc-800/80 dark:bg-zinc-950/90">
      <!-- User Nav -->
      <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-2.5 sm:px-6">
        <.link
          navigate={~p"/"}
          class="flex items-center gap-1.5 font-mono text-base font-semibold text-zinc-900 hover:text-black dark:text-zinc-100 dark:hover:text-white"
        >
          <span class="text-brand">~/</span>game_site
        </.link>

        <ul class="flex flex-wrap items-center gap-3 text-sm">
          <li><.theme_toggle /></li>
          <%= if @current_user do %>
            <li class="hidden max-w-xs truncate font-mono text-xs text-zinc-500 sm:inline">
              {@current_user.email}
            </li>
            <li>
              <.link href={~p"/users/settings"} class="nav-link">Settings</.link>
            </li>
            <li>
              <.link href={~p"/users/log_out"} method="delete" class="nav-link">Log out</.link>
            </li>
          <% else %>
            <li>
              <.link href={~p"/users/register"} class="nav-link">Register</.link>
            </li>
            <li>
              <.link href={~p"/users/log_in"} class="nav-link">Log in</.link>
            </li>
          <% end %>
        </ul>
      </div>

      <!-- Navigation bar -->
      <nav class="border-t border-zinc-200/80 dark:border-zinc-800/80">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-1 px-4 py-2">
          <.link navigate={~p"/"} class="nav-link">Home</.link>
          <.link navigate={~p"/scores"} class="nav-link">Scores</.link>

          <!-- Single Player -->
          <div x-data="{ open: false }" x-on:click.outside="open = false" class="relative">
            <button type="button" class="nav-link" x-on:click="open = !open">
              Single Player
            </button>

            <div
              x-cloak
              x-show="open"
              x-transition
              class="absolute left-0 z-30 mt-2 min-w-[200px] overflow-hidden rounded-md border border-zinc-200 bg-white shadow-lg dark:border-zinc-800 dark:bg-zinc-900"
            >
              <div class="flex flex-col py-1">
                <.link navigate={~p"/guessing"} class="dropdown-link">Guessing Game</.link>
                <.link navigate={~p"/math"} class="dropdown-link">Math Game</.link>
                <.link navigate={~p"/rock-paper-scissors"} class="dropdown-link">
                  Rock Paper Scissors
                </.link>
                <.link navigate={~p"/wordle"} class="dropdown-link">Wordle</.link>
                <.link navigate={~p"/poker"} class="dropdown-link">Poker</.link>
                <.link navigate={~p"/pento_choice"} class="dropdown-link">Pento</.link>
              </div>
            </div>
          </div>

          <!-- Multiplayer -->
          <div x-data="{ open: false }" x-on:click.outside="open = false" class="relative">
            <button type="button" class="nav-link" x-on:click="open = !open">
              Multiplayer
            </button>

            <div
              x-cloak
              x-show="open"
              x-transition
              class="absolute left-0 z-30 mt-2 min-w-[200px] overflow-hidden rounded-md border border-zinc-200 bg-white shadow-lg dark:border-zinc-800 dark:bg-zinc-900"
            >
              <div class="flex flex-col py-1">
                <.link navigate={~p"/multi-poker"} class="dropdown-link">Poker</.link>
                <.link navigate={~p"/daily-wordle"} class="dropdown-link">Daily Wordle</.link>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Main content -->
    <main class="mx-auto w-full max-w-6xl flex-grow px-4 py-6 sm:px-6">
      {@inner_content}
    </main>

    <footer class="mt-16 border-t border-zinc-200/80 py-8 dark:border-zinc-800/80">
      <div class="mx-auto flex w-full max-w-6xl flex-col items-center gap-2 px-4 text-center font-mono text-xs text-zinc-500 sm:px-6 dark:text-zinc-600">
        <p>Built with Elixir &amp; Phoenix.</p>
        <div class="flex items-center gap-3">
          <a
            href="https://github.com/adamvietro"
            target="_blank"
            rel="noopener"
            class="hover:text-brand"
          >
            github.com/adamvietro
          </a>
          <span aria-hidden="true">&middot;</span>
          <a href="https://blog.adamsites.com/" target="_blank" rel="noopener" class="hover:text-brand">
            blog
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
